# URL del proyecto Supabase (Settings → API)
VITE_SUPABASE_URL=

# Clave anon / publishable (Settings → API). Nunca uses la service_role aquí.
VITE_SUPABASE_ANON_KEY=

# URL pública de la landing (Ecofarma-Landing). En local: http://localhost:5174
# En Vercel: la URL de producción de la landing (sin barra final).
VITE_LANDING_URL=http://localhost:5174
